# enabled = allow anyone to sign up
# disabled = users must be invited
# default is disabled
USER_REGISTRATION=enabled

EMAIL_DOMAIN=yourdomain.tld
EMAIL_USER_NAME=your@email
EMAIL_PASSWORD=yourpassword

# GITHUB_KEY=oauth-client-id
# GITHUB_SECRET=oauth-client-secret
# GITHUB_USER_TOKEN=user-token
# GITHUB_WEBHOOK_SECRET=webhook-secret

GITHUB_USER_TOKEN=user-access-token

QUEUE_POLLING_INTERVAL=2

ROLLBAR_TOKEN=rollbar-token

# set to false if using separate job runner
# default is true
# SOLID_QUEUE_IN_PUMA=false
